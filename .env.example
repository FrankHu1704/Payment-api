# URL do projeto Supabase (Project Settings > API > Project URL)
SUPABASE_URL=https://xxxxxxxx.supabase.co

# Chave anon/publishable do Supabase (Project Settings > API > anon key)
SUPABASE_ANON_KEY=eyJhbGciOi...

# Chave secreta que o monitor Termux deve enviar em "Authorization: Bearer <SMS_API_KEY>"
SMS_API_KEY=defina-uma-chave-forte-aqui

# ── M-Pesa Payments Gateway (developer.mpesa.vm.co.mz) ──
# API Key e Public Key da aba "Testing" do seu perfil (nunca a de "Production" aqui).
# Renove a chave no portal se ela já tiver aparecido em algum lugar inseguro.
MPESA_API_KEY=sua-api-key-de-sandbox
MPESA_PUBLIC_KEY=sua-public-key-base64-de-sandbox
# Host da gateway (sandbox por padrão; troque ao ir para produção)
MPESA_HOST=api.sandbox.vm.co.mz
MPESA_ORIGIN=developer.mpesa.vm.co.mz
# Shortcode do seu negócio (Service Provider Code)
MPESA_SERVICE_PROVIDER_CODE=171717
# Só necessários para o endpoint de Reversal
MPESA_INITIATOR_IDENTIFIER=
MPESA_SECURITY_CREDENTIAL=

# Chave secreta que protege /api/mpesa/* (C2B, Reversal, Status) — só seu backend/frontend
# deve chamar esses endpoints, nunca o navegador do cliente final.
GATEWAY_API_KEY=defina-outra-chave-forte-aqui
